{
	"name": "PL_Send_Email",
	"properties": {
		"activities": [
			{
				"name": "read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select *\nFROM [ctrl].[audit_log]\nwhere adf_run_id in ('@{pipeline().parameters.adf_run_id}')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare email body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and transformation process for caresync project has been completed. below is the status"
				}
			},
			{
				"name": "prepare email body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support. please reach out to me"
				}
			},
			{
				"name": "Set Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check SUCCESS OR FAILURE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check SUCCESS OR FAILURE').output.firstRow.count, 0),'FAILED', 'SUCCESS')} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check SUCCESS OR FAILURE",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count\nFROM [ctrl].[audit_log]\nwhere adf_run_id in ('@{pipeline().parameters.adf_run_id}')\nAND STATUS !='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\" @{variables('email_subject')} \",\n\"email receipients\":\"@{pipeline().globalParameters.email_receipents}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body footer\":\"@{variables('body_footer')}\",\n\"status_table\":activity('read all tables status').output.value\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "e3bc8ab9-4d49-4af0-a72d-83df54c44f16"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}